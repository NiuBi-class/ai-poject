void setup() {
  Serial.begin(9600);
  u8g2.begin();
}

void updateDisplay(String text) {
  u8g2.clearBuffer();
  
  // 顯示圖片
  u8g2.setDrawColor(1);
  u8g2.drawXBMP(0, 0, 64, 64, anime_girl_64x64);
  
  // 右顯示文字
  u8g2.setFont(u8g2_font_logisoso16_tr);
  u8g2.setCursor(68, 38);
  u8g2.print(text);
  
  u8g2.sendBuffer();
}

void loop() {
  if (Serial.available() > 0) {
    String input = Serial.readStringUntil('\n');
    input.trim();
    input.toUpperCase(); // 轉大寫
    
    updateDisplay(input);
  }
}